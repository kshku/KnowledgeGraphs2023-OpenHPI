# Model settings
KG_MODEL_PROVIDER=openai
KG_MODEL_NAME=gpt-4o-mini

# Read-only knowledge graph and query limits
KG_READ_ONLY=true
KG_MAX_SPARQL_ROWS=50

# Provider API keys (set the one matching KG_MODEL_PROVIDER)
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENROUTER_API_KEY=your-openrouter-key
