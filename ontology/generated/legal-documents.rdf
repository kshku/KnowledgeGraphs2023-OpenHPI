  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section19_Reference4">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section19_Passage1"/>
    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">section 17</legal:referenceText>
    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section17"/>
    <legal:resolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolved</legal:resolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section19_Reference5">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section19_Passage1"/>
    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">section 18</legal:referenceText>
    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section18"/>
