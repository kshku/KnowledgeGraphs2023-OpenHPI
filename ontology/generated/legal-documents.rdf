    <legal:sectionTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Short title, extent, commencement and application</legal:sectionTitle>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#consumer-protection-act-2019_Section10">
