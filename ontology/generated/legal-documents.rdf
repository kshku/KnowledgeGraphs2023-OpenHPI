    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">section 83</legal:referenceText>
    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#railways-act-1989_Section83"/>
    <legal:resolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolved</legal:resolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#railways-act-1989_Section86">
    <rdf:type rdf:resource="https://example.org/legal-ontology#Provision"/>
    <legal:containsPassage rdf:resource="https://example.org/legal-ontology#railways-act-1989_Section86_Passage1"/>
    <legal:sectionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">86</legal:sectionNumber>
    <legal:sectionTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sales under sections 83 to 85 not to affect the right to suit</legal:sectionTitle>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#railways-act-1989_Section86_Passage1">
    <rdf:type rdf:resource="https://example.org/legal-ontology#TextPassage"/>
    <legal:pageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36</legal:pageNumber>
    <legal:text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">86. Sales under sections 83 to 85 not to affect the right to suit.—Notwithstanding anything contained
in this Chapter, the right of sale under sections 83 to 85 shall be without prejudice to the right of the railway
administration to recover by suit, any freight, charge, amount or other expenses due to it.</legal:text>
  </rdf:Description>
