    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#jammu-and-kashmir-reorganisation-act-2019_Section89"/>
    <legal:resolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolved</legal:resolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#jammu-and-kashmir-reorganisation-act-2019_Section90_Reference4">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
