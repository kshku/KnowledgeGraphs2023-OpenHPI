  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section47">
    <rdf:type rdf:resource="https://example.org/legal-ontology#Provision"/>
    <legal:containsPassage rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section47_Passage1"/>
    <legal:sectionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">47</legal:sectionNumber>
    <legal:sectionTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crediting sums realised by way of penalties to Consolidated Fund of India</legal:sectionTitle>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section47_Passage1">
    <rdf:type rdf:resource="https://example.org/legal-ontology#TextPassage"/>
    <legal:pageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</legal:pageNumber>
    <legal:text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">47. Crediting sums realised by way of penalties to Consolidated Fund of India.—All sums
realised by way of penalties 3[and recovery of legal costs by the Commission] under this Act shall be
credited to the Consolidated Fund of India.

1. Subs. by Act 9 of 2023, s. 32, for “punishable with fine” (w.e.f. 18-5-2023).
2. Subs. by s. 33, ibid, for section 46 (w.e.f. 20-2-2024).
3. Ins. by s. 34, ibid., (w.e.f. 10-9-2024).
IndiaCode
34</legal:text>
  </rdf:Description>
