    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#jammu-and-kashmir-reorganisation-act-2019_Section60"/>
    <legal:resolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolved</legal:resolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#jammu-and-kashmir-reorganisation-act-2019_Section62_Reference4">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#jammu-and-kashmir-reorganisation-act-2019_Section62_Passage1"/>
