  <rdf:Description rdf:about="https://example.org/legal-ontology#jammu-and-kashmir-reorganisation-act-2019_Section76_Reference5">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#jammu-and-kashmir-reorganisation-act-2019_Section76_Passage1"/>
