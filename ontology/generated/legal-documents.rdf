  <rdf:Description rdf:about="https://example.org/legal-ontology#mediation-act-2023_Section52_Reference5">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#mediation-act-2023_Section52_Passage1"/>
