  <rdf:Description rdf:about="https://example.org/legal-ontology#food-safety-and-standards-act-2006_Section91_Reference12">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:externalLaw rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indian Penal Code</legal:externalLaw>
