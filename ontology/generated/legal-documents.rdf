    <legal:occursIn rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section53B_Passage1"/>
    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">section 53A</legal:referenceText>
    <legal:resolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unresolved</legal:resolutionStatus>
