    <legal:resolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolved</legal:resolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#railways-act-1989_Section200_Reference2">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:externalLaw rdf:datatype="http://www.w3.org/2001/XMLSchema#string">General Clauses Act, 1897</legal:externalLaw>
