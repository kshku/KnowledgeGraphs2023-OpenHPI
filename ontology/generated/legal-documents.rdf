  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section43A_Reference7">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section43A_Passage1"/>
