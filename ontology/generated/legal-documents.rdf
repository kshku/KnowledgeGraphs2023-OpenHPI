  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section1">
    <rdf:type rdf:resource="https://example.org/legal-ontology#Provision"/>
    <legal:containsPassage rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section1_Passage1"/>
