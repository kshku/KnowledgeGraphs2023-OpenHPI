  <rdf:Description rdf:about="https://example.org/legal-ontology#consumer-protection-act-2019_Section38_Reference6">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#consumer-protection-act-2019_Section38_Passage1"/>
    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">section 2</legal:referenceText>
    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#consumer-protection-act-2019_Section2"/>
    <legal:resolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolved</legal:resolutionStatus>
