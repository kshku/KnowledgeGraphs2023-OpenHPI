    <legal:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Consumer Protection Act, 2019</legal:title>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#consumer-protection-act-2019_Section1">
    <rdf:type rdf:resource="https://example.org/legal-ontology#Provision"/>
